NODE_ENV=production
HOST=0.0.0.0
PORT=3000
HOST_PROFILE=boosted
ENABLE_SERVER_METRICS=true
MAX_CONNECTIONS=80
MAX_LOBBIES=40
# Comma-separated origins allowed to open socket.io connections.
# Leave blank during first deploy, then set after your Render/custom domains are live.
ALLOWED_ORIGINS=https://riftrunner.gg,https://www.riftrunner.gg
